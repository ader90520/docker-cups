FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=zh_CN.UTF-8 \
    LANGUAGE=zh_CN:zh \
    LC_ALL=zh_CN.UTF-8 \
    TZ=Asia/Shanghai \
    OPENCV_LOG_LEVEL=ERROR \
    OMP_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 \
    MALLOC_ARENA_MAX=1 \
    PYTHONMALLOC=malloc

# 1. 系统底层、打印/扫描驱动、无头 Python 运行库与 CJK 编码支持
RUN apt-get update && apt-get install -y --no-install-recommends \
    cups \
    cups-client \
    cups-filters \
    cups-browsed \
    foomatic-db-engine \
    poppler-data \
    fonts-wqy-microhei \
    avahi-daemon \
    dbus \
    locales \
    gettext \
    ca-certificates \
    curl \
    wget \
    usbutils \
    net-tools \
    printer-driver-foo2zjs \
    hplip \
    sane-utils \
    libsane-common \
    libsane-hpaio \
    sane-airscan \
    python3 \
    python3-pil \
    python3-tornado \
    python3-requests \
    python3-numpy \
    libjpeg62-turbo \
    libpng16-16 \
    libglib2.0-0 \
    libgomp1 \
    xz-utils \
    dos2unix \
    && sed -i -e 's/# zh_CN.UTF-8 UTF-8/zh_CN.UTF-8 UTF-8/' /etc/locale.gen \
    && locale-gen \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/* /usr/share/doc/* /usr/share/man/* /usr/share/info/* /root/.cache

# 2. 拷贝代码与静态文件资产
COPY modules/ /opt/modules/
COPY webapp/ /opt/webapp/
COPY entrypoint.sh /entrypoint.sh
COPY i18/ /opt/i18/

# 3. 动态注入轻量 cv2.so 并清除源码包
RUN if [ -f /opt/modules/cv2.so ]; then \
        cp /opt/modules/cv2.so /usr/lib/python3/dist-packages/cv2.so && \
        chmod 755 /usr/lib/python3/dist-packages/cv2.so; \
    elif [ -f /opt/modules/cv2.tar.xz ]; then \
        tar -xf /opt/modules/cv2.tar.xz -C /usr/lib/python3/dist-packages/ && \
        rm -f /opt/modules/cv2.tar.xz; \
    fi

# 4. 固化驱动、汉化模板深度注入、目录结构预置与清理
ARG HPLIP_VER=3.22.10
RUN find /opt/modules/ /opt/webapp/ /entrypoint.sh -type f -exec dos2unix {} + 2>/dev/null || true \
    && chmod -R +x /opt/modules/ /opt/webapp/ /entrypoint.sh 2>/dev/null || true \
    && cd /tmp \
    && (wget -q -c --timeout=20 --tries=3 "https://downloads.sourceforge.net/project/hplip/hplip-plugins/${HPLIP_VER}/hplip-${HPLIP_VER}-plugin.run" || true) \
    && if [ -f hplip-${HPLIP_VER}-plugin.run ]; then \
        chmod +x hplip-${HPLIP_VER}-plugin.run && \
        printf "y\na\ny\n" | hp-plugin -i -p /tmp 2>&1 || true; \
    fi \
    && /bin/bash /opt/modules/drivers/install_foo2zjs.sh || true \
    && /bin/bash /opt/modules/drivers/install_hp_plugin.sh || true \
    && /bin/bash /opt/modules/theme/patch_cups_theme.sh || true \
    && mkdir -p /usr/share/cups/templates/zh_CN \
                /usr/share/cups/templates/zh \
                /usr/share/cups/templates/zh-CN \
                /usr/share/cups/templates/zh_Hans \
                /usr/share/cups/locale/zh_CN \
                /usr/share/cups/locale/zh \
                /usr/share/cups/locale/zh-CN \
                /usr/share/cups/doc-root/zh_CN \
                /usr/share/cups/doc-root/zh \
                /opt/cups_data \
                /scans \
                /opt/webapp/data \
                /opt/webapp/static \
                /opt/webapp/models \
                /tmp/cups_web_uploads \
                /tmp/mail_print_tasks \
                /etc/cups/ssl \
                /var/lock/sane \
                /var/run/dbus \
    && PO_FILE="" \
    && if [ -f /opt/i18/cups_zh.po ]; then PO_FILE="/opt/i18/cups_zh.po"; \
       elif [ -f /opt/i18/cups_zh_CN.po ]; then PO_FILE="/opt/i18/cups_zh_CN.po"; \
       elif [ -f /opt/i18/zh_CN.po ]; then PO_FILE="/opt/i18/zh_CN.po"; fi \
    && if [ -n "$PO_FILE" ]; then \
        msgfmt -o /usr/share/cups/locale/zh_CN/cups_zh_CN.mo "$PO_FILE" && \
        cp -f /usr/share/cups/locale/zh_CN/cups_zh_CN.mo /usr/share/cups/locale/zh/cups_zh.mo && \
        cp -f /usr/share/cups/locale/zh_CN/cups_zh_CN.mo /usr/share/cups/locale/zh-CN/cups_zh-CN.mo && \
        cp -f /usr/share/cups/locale/zh_CN/cups_zh_CN.mo /usr/share/cups/locale/zh/cups_zh_CN.mo || true; \
    fi \
    && TMPL_DIR="" \
    && if [ -d /opt/i18/zh_CN ]; then TMPL_DIR="/opt/i18/zh_CN"; \
       elif [ -d /opt/i18/templates ]; then TMPL_DIR="/opt/i18/templates"; \
       elif [ -d /opt/i18/tmpl ]; then TMPL_DIR="/opt/i18/tmpl"; fi \
    && if [ -n "$TMPL_DIR" ]; then \
        cp -rf "$TMPL_DIR"/*.tmpl /usr/share/cups/templates/zh_CN/ 2>/dev/null || true; \
        cp -rf "$TMPL_DIR"/*.tmpl /usr/share/cups/templates/zh/ 2>/dev/null || true; \
        cp -rf "$TMPL_DIR"/*.tmpl /usr/share/cups/templates/zh-CN/ 2>/dev/null || true; \
        cp -rf "$TMPL_DIR"/*.tmpl /usr/share/cups/templates/zh_Hans/ 2>/dev/null || true; \
        cp -rf "$TMPL_DIR"/*.tmpl /usr/share/cups/templates/ 2>/dev/null || true; \
    fi \
    && if [ -f /opt/i18/zh_CN/index.html ]; then \
        cp -f /opt/i18/zh_CN/index.html /usr/share/cups/doc-root/index.html && \
        cp -f /opt/i18/zh_CN/index.html /usr/share/cups/doc-root/zh_CN/index.html; \
    elif [ -f /opt/i18/index.html ]; then \
        cp -f /opt/i18/index.html /usr/share/cups/doc-root/index.html && \
        cp -f /opt/i18/index.html /usr/share/cups/doc-root/zh_CN/index.html; \
    fi \
    && ln -sf /usr/share/cups/doc-root/index.html /usr/share/cups/doc-root/index.html.zh 2>/dev/null || true \
    && ln -sf /usr/share/cups/doc-root/index.html /usr/share/cups/doc-root/index.html.zh_CN 2>/dev/null || true \
    && chmod -R 755 /usr/share/cups/templates /usr/share/cups/locale /usr/share/cups/doc-root 2>/dev/null || true \
    && chmod -R 777 /scans /opt/webapp/data /opt/webapp/static /opt/webapp/models /tmp/mail_print_tasks /tmp/cups_web_uploads /var/lock/sane /var/run/dbus \
    && chmod 700 /etc/cups/ssl \
    && rm -rf /opt/webapp/models/* \
              /tmp/* \
              /var/tmp/* \
              /root/.cache \
              /root/.hplip \
              /opt/modules/*.run \
              /opt/modules/*.tar*

EXPOSE 631 8088
ENTRYPOINT ["/entrypoint.sh"]
